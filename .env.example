# AtSolution Comic Studio workflow configuration
# Copy this file to `.env` and fill in your real API keys.

# Planning endpoint, OpenAI-compatible chat completions.
PLANNING_BASE_URL=https://jmrai.net
PLANNING_API_KEY=
PLANNING_MODEL=gemini-3.1-pro
PLANNING_MAX_TOKENS=12000

# Image generation endpoint, OpenAI-compatible image generations.
IMAGE_BASE_URL=https://jmrai.net
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2

# Portrait comic page. Width and height must both be divisible by 16.
IMAGE_SIZE=1248x1664
IMAGE_PARALLELISM=3
IMAGE_RETRY_ATTEMPTS=2

# Local project output root. Runs are saved under:
# build/projects/<project-slug>/<run-id>/
COMICPUBLISH_OUTPUT_DIR=build
REQUEST_TIMEOUT_SECONDS=300
